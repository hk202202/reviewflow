# Database
DATABASE_URL=postgresql+asyncpg://reviewflow:reviewflow@localhost:5432/reviewflow
DATABASE_URL_SYNC=postgresql://reviewflow:reviewflow@localhost:5432/reviewflow

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Email (Resend)
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=notifications@reviewflow.io

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Encryption
ENCRYPTION_KEY=change-me-32-byte-encryption-key-here

# Chrome Extension
EXTENSION_ID=your-extension-id

# Google Business Profile OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/platforms/google/callback
FRONTEND_URL=http://localhost:3000

# Razorpay (get keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
