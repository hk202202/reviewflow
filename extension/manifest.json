{
  "manifest_version": 3,
  "name": "ReviewFlow — AI Review Manager",
  "version": "1.2.0",
  "description": "Optional add-on for all platforms — import reviews and AI reply assist on Amazon, Flipkart, Myntra, and more.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://sellercentral.amazon.in/*",
    "https://sellercentral.amazon.com/*",
    "https://seller.flipkart.com/*",
    "https://*.myntra.com/*",
    "https://*.meesho.com/*",
    "https://business.google.com/*",
    "http://localhost:3000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://sellercentral.amazon.in/*", "https://sellercentral.amazon.com/*"],
      "js": ["content/shared.js", "content/amazon.js"],
      "css": ["content/inject.css"]
    },
    {
      "matches": ["https://seller.flipkart.com/*"],
      "js": ["content/shared.js", "content/flipkart.js"],
      "css": ["content/inject.css"]
    },
    {
      "matches": ["https://*.myntra.com/*"],
      "js": ["content/shared.js", "content/myntra.js"],
      "css": ["content/inject.css"]
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content/detector.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": ["http://localhost:3000/*"]
  }
}
